                      <Option name="expression" value="CASE&#13;&#10;  WHEN (sqrt(area(transform($geometry, 'EPSG:4326', 'EPSG:3857'))) / @map_scale) * 700 &lt; 16 THEN 0.8  -- Minimum size&#13;&#10;  WHEN (sqrt(area(transform($geometry, 'EPSG:4326', 'EPSG:3857'))) / @map_scale) * 700 &gt; 20 THEN 1.2  -- Maximum size&#13;&#10;  ELSE 1&#13;&#10;END" type="QString"/>
