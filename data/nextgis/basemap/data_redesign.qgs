                      <Option name="expression" value="CASE&#13;&#10;  WHEN (sqrt(area(transform($geometry, 'EPSG:4326', 'EPSG:3857'))) / @map_scale) * 700 &gt; 20 THEN&#13;&#10;    'upper'&#13;&#10;  ELSE&#13;&#10;    'nochange'&#13;&#10;END" type="QString"/>
